{
  "name": "website",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio website of Paolo Vezzini",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve.mjs",
    "icons": "node scripts/build-icons.mjs",
    "vendor:draco": "node scripts/vendor-draco.mjs",
    "og": "node scripts/build-og-image.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run lint:html"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.1",
    "jsdom": "^30.1.1",
    "lucide-static": "^1.49.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1"
  }
}
