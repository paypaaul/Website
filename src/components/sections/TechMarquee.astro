---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icon-names';
import { getDictionary, getLang } from '@/i18n';

const t = getDictionary(getLang(Astro));
const s = t.marquee.skills;

const items: { icon: IconName; label: string }[] = [
  { icon: 'brand-python', label: s.python },
  { icon: 'terminal', label: s.embedded },
  { icon: 'cube', label: s.cad },
  { icon: 'printer', label: s.printing },
  { icon: 'cpu', label: s.electronics },
  { icon: 'brand-github', label: s.github },
];
---

<section aria-labelledby="marquee-label" class="border-y border-border bg-card/40 py-10">
  <p
    id="marquee-label"
    class="text-center font-mono text-xs tracking-widest text-muted-foreground uppercase"
  >
    {t.marquee.label}
  </p>
  <div class="marquee mt-7">
    {[0, 1].map((copy) => (
      <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <li class="inline-flex items-center gap-2.5 rounded-full border border-border bg-card px-5 py-2.5 text-sm font-medium whitespace-nowrap">
            <Icon name={item.icon} class="text-lg text-muted-foreground" />
            {item.label}
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
