---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import type { Project } from '@/data/projects';
import { getDictionary, projectPath, type Lang } from '@/i18n';

interface Props {
  project: Project;
  lang: Lang;
  /** Stagger of the reveal animation, in ms. */
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const t = getDictionary(lang);
---

<article
  class="card group relative overflow-hidden"
  data-spotlight
  data-reveal
  data-reveal-delay={delay}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-border">
    <Image
      src={project.cover}
      alt={project.coverAlt[lang]}
      widths={[480, 768, 1024]}
      sizes="(min-width: 1152px) 552px, (min-width: 1024px) 45vw, calc(100vw - 3rem)"
      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"
      aria-hidden="true"
    ></div>
    <span class="chip absolute top-4 left-4 border-white/25 bg-black/40 text-white backdrop-blur">
      {project.status[lang]}
    </span>
  </div>

  <div class="p-6 sm:p-8">
    <p class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
      {project.kind[lang]} · {project.version}
    </p>
    <h3 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
      <a href={projectPath(lang, project.slug)} class="stretched-link">
        {project.name}
      </a>
    </h3>
    <p class="mt-3 text-muted-foreground">{project.summary[lang]}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <li class="chip">{tag}</li>
      ))}
    </ul>
    <p class="mt-7 inline-flex items-center gap-2 text-sm font-medium">
      {t.projects.cta}
      <Icon
        name="arrow-up-right"
        class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </p>
  </div>
</article>
