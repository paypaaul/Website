---
/**
 * Decorative hero background: two mirrored fans of curves along which a light slowly flows.
 *
 * Port of the "Background Paths" component from 21st.dev (React + framer-motion) to plain SVG + CSS
 * animation (see `.paths` in styles/effects.css), so it ships no JavaScript. The geometry is the same
 * as the original; the curves are generated at build time. Purely decorative: hidden from assistive
 * technology, ignores the pointer, and stands still with `prefers-reduced-motion`.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// The original draws 36 curves per fan. Animating that many strokes is the expensive part, so we draw
// half as many and space them twice as far apart: same footprint, lighter to render.
const COUNT = 18;
const STEP = 2;

/** One fan of curves; `side` (1 or -1) mirrors it. */
function fan(side: 1 | -1) {
  return Array.from({ length: COUNT }, (_, n) => {
    const i = n * STEP;
    const dx = i * 5 * side;
    const dy = i * 6;
    const d =
      `M${dx - 380} ${-189 - dy}C${dx - 380} ${-189 - dy} ${dx - 312} ${216 - dy} ${152 - dx} ${343 - dy}` +
      `C${616 - dx} ${470 - dy} ${684 - dx} ${875 - dy} ${684 - dx} ${875 - dy}`;
    return {
      d,
      width: +(0.5 + i * 0.03).toFixed(2),
      // Thin curves are fainter than thick ones, which gives the fan its depth.
      opacity: +Math.min(1, 0.1 + i * 0.03).toFixed(2),
    };
  });
}

const fans = [fan(1), fan(-1)];
---

<div class:list={['paths', className]} aria-hidden="true">
  <svg class="paths__svg" viewBox="0 0 696 316" fill="none" focusable="false">
    {fans.map((lines) => (
      <g>
        {lines.map((line) => (
          <path
            class="paths__line"
            d={line.d}
            pathLength="1"
            stroke="currentColor"
            stroke-width={line.width}
            stroke-opacity={line.opacity}
          />
        ))}
      </g>
    ))}
  </svg>
</div>
