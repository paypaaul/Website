---
interface Props {
  /** Small mono label above the title. */
  eyebrow: string;
  title: string;
  description?: string;
  /** Position number shown before the eyebrow, e.g. "01". */
  index?: string;
  /** Id of the <h2>, referenced by the section's aria-labelledby. */
  id: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, index, id, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p class:list={['eyebrow', align === 'center' && 'justify-center']}>
    {index && <span class="text-accent-text">{index}</span>}
    {eyebrow}
  </p>
  <h2 id={id} class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
    {title}
  </h2>
  {description && <p class="mt-4 text-lg text-muted-foreground">{description}</p>}
</div>
